{
  "expo": {
    "name": "Recipe Forge",
    "slug": "recipe-forge",
    "scheme": "recipe-forge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recipeforge.app"
    },
    "android": {
      "package": "com.recipeforge.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
